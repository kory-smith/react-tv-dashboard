// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  hashedPassword String
  role           Role      @default(EMPLOYEE)
  employeeId     Int?      @unique // Optional: A user might be an admin/manager without being an employee
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade) // If user is deleted, also delete the linked employee (which cascades)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Employee {
  id           Int          @id @default(autoincrement())
  name         String
  wrongNumbers Int          @default(0)
  scores       Score[]      // Changed to one-to-many relationship
  trendPoints  TrendPoint[]
  user         User?        // Link back to the User model
}

model Score {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  score      Int      @default(0)
}

model TrendPoint {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  score      Int
}
